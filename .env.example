POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_super_strong

GLITCHTIP_DB_NAME=glitchtip
GLITCHTIP_DB_USER=glitchtip_user
GLITCHTIP_DB_PASSWORD=change_me

FLAGSMITH_DB_NAME=flagsmith
FLAGSMITH_DB_USER=flagsmith_user
FLAGSMITH_DB_PASSWORD=change_me

OPENFGA_DB_NAME=openfga
OPENFGA_DB_USER=openfga_user
OPENFGA_DB_PASSWORD=change_me

GLITCHTIP_SECRET_KEY=change_me_random_hex_64_chars
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_DEFAULT_FROM_EMAIL=glitchtip@votredomaine.tld
GLITCHTIP_DOMAIN=https://errors.votredomaine.tld

FLAGSMITH_SECRET_KEY=change_me_random
FLAGSMITH_DOMAIN=https://flags.votredomaine.tld

# errors.domain.com     -> glitchtip:8000
# flags.domain.com      -> flagsmith:8000
# uptime.domain.com     -> uptime-kuma:3001
# stats.domain.com      -> goatcounter:8080
# push.domain.com       -> ntfy:80
# files.domain.com      -> seaweedfs:8333
# authz.domain.com      -> openfga:8080 (API, pas d'UI)
#
# Pas de domaine pour postgres, valkey : ce sont des protocoles TCP bruts
# (pas HTTP), pas de routage Traefik/domaine classique. Seuls les autres
# services de ce compose y accèdent, via leur nom sur le réseau Docker interne
# (ex: postgres:5432) — vos apps ont leur propre Redis, pas besoin d'y toucher ici.
